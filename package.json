{
  "name": "playwright-demo",
  "version": "1.0.0",
  "description": "To make it easy for you to get started with GitLab, here's a list of recommended next steps.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:all:ui": "npx playwright test --ui",
    "test:all:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test tests/e2e --ui",
    "test:e2e:headed": "npx playwright test tests/e2e --headed",
    "test:visual": "percy exec -- npx playwright test tests/visual --project=chromium",
    "test:accessibility": "npx playwright test accessibility",
    "test:accessibility:ui": "npx playwright test accessibility --ui",
    "test:report": "npx playwright show-report"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/stefan.ciuchi/playwright-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://gitlab.com/stefan.ciuchi/playwright-demo/issues"
  },
  "homepage": "https://gitlab.com/stefan.ciuchi/playwright-demo#readme",
  "devDependencies": {
    "@percy/cli": "^1.32.9",
    "@percy/playwright": "^1.1.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0"
  }
}
